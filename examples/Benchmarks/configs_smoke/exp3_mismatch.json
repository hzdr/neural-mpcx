{
  "id": "exp3",
  "name": "Mismatch and disturbances (smoke)",
  "description": "Smoke-scale copy of exp3: the same code paths and the same cases, over tiny designs and short runs. Use it to check the pipeline before committing a cluster to the full study. A smoke run produces no results.",
  "benchmarks": [
    "cstr",
    "cts"
  ],
  "timing_critical": false,
  "group_by": [],
  "per_benchmark": {
    "cstr": {
      "num_iter": 10
    },
    "cts": {
      "num_iter": 30
    }
  },
  "cases": [
    {
      "case": "mismatch_lhs_cstr",
      "benchmarks": [
        "cstr"
      ],
      "sample": {
        "kind": "lhs_params",
        "n": 4,
        "params": {
          "alpha": [
            0.95,
            1.05
          ],
          "beta": [
            0.9,
            1.1
          ]
        }
      }
    },
    {
      "case": "mismatch_lhs_cts",
      "benchmarks": [
        "cts"
      ],
      "sample": {
        "kind": "lhs_params",
        "n": 4,
        "params": {
          "mismatch_factor": [
            0.95,
            1.05
          ],
          "gain_mismatch": [
            0.95,
            1.05
          ]
        }
      }
    },
    {
      "case": "envelope_cstr",
      "benchmarks": [
        "cstr"
      ],
      "sample": {
        "kind": "lhs_params",
        "n": 8,
        "seed_index": 1,
        "params": {
          "alpha": [
            0.8,
            1.2
          ],
          "beta": [
            0.8,
            1.2
          ]
        }
      }
    },
    {
      "case": "envelope_cts",
      "benchmarks": [
        "cts"
      ],
      "sample": {
        "kind": "lhs_params",
        "n": 8,
        "seed_index": 1,
        "params": {
          "mismatch_factor": [
            0.8,
            1.2
          ],
          "gain_mismatch": [
            0.8,
            1.2
          ]
        }
      }
    },
    {
      "case": "disturbance_CA0",
      "benchmarks": [
        "cstr"
      ],
      "set": {
        "dist_kind": "CA0",
        "dist_onset": 4,
        "num_iter": 12
      },
      "sweep": {
        "dist_magnitude": [
          -0.2,
          0.2
        ]
      }
    },
    {
      "case": "disturbance_Tin",
      "benchmarks": [
        "cstr"
      ],
      "set": {
        "dist_kind": "Tin",
        "dist_onset": 4,
        "num_iter": 12
      },
      "sweep": {
        "dist_magnitude": [
          -0.2,
          0.2
        ]
      }
    },
    {
      "case": "disturbance_leak2",
      "benchmarks": [
        "cts"
      ],
      "set": {
        "dist_kind": "leak2",
        "dist_onset": 12,
        "num_iter": 30
      },
      "sweep": {
        "dist_magnitude": [
          0.2,
          0.5
        ]
      }
    },
    {
      "case": "disturbance_none",
      "set": {
        "dist_magnitude": 0.0
      }
    },
    {
      "case": "neural_vs_nmpc",
      "benchmarks": [
        "cstr"
      ],
      "sweep": {
        "controller": [
          "neural",
          "nmpc"
        ],
        "alpha": [
          0.9,
          1.1
        ],
        "beta": [
          1.0
        ]
      }
    }
  ]
}
